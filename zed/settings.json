// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "cli_default_open_behavior": "existing_window",
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "language_models": {
        "openai_compatible": {
            "llamacpp_big_context": {
                "api_url": "http://192.168.0.220:11434/v1",
                "available_models": [
                    {
                        "name": "qwen3.6-35b",
                        "max_tokens": 65536,
                        "max_output_tokens": 65536,
                        "max_completion_tokens": 65536,
                        "capabilities": {
                            "tools": true,
                            "images": false,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true,
                            "interleaved_reasoning": false
                        }
                    }
                ]
            }
        },
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
        "default_model": {
            "provider": "llamacpp_big_context",
            "model": "qwen3.6-35b",
        },
        "profiles": {
            "plan": {
                "name": "Plan",
                "tools": {
                    "find_path": true,
                    "grep": true,
                    "read_file": true,
                    "list_directory": true,
                    "thinking": true,
                    "fetch": true,
                    "edit_file": false,
                    "create_file": false,
                    "move_path": false,
                    "copy_path": false,
                    "delete_path": false,
                    "terminal": false,
                },
                "enable_all_context_servers": false,
            },
        },
    },
    "git_panel": {
        "dock": "left",
    },
    "edit_predictions": {
        "provider": "none",
    },
    "ui_font_family": ".SystemUIFont",
    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": true,
    },
    "buffer_line_height": "comfortable",
    "diagnostics_max_severity": "error",
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "effort": "high",
                "model": "opus",
            },
            "type": "registry",
        },
    },
    "icon_theme": "Material Icon Theme",
    "session": {
        "trust_all_worktrees": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "base_keymap": "VSCode",
    "minimap": {
        "show": "never",
    },
    "file_types": {
        "rmd": ["*.rmd"],
    },
    "format_on_save": "on",
    "sticky_scroll": { "enabled": false },
    "show_edit_predictions": true,
    "wrap_guides": [80],
    "ui_font_size": 16,
    "buffer_font_family": "Fira Code",
    "buffer_font_features": { "calt": true, "liga": true },
    "buffer_font_size": 14.0,
    "git": { "git_gutter": "hide" },
    "theme": {
        "mode": "system",
        "light": "Ayu Light",
        "dark": "Kanagawa",
    },
    "lsp": {
        "pylsp": {
            "settings": {
                "pylsp": {
                    "plugins": {
                        "jedi_completion": { "enabled": true },
                        "jedi_hover": { "enabled": true },
                        "jedi_references": { "enabled": true },
                        "jedi_signature_help": { "enabled": true },
                        "jedi_symbols": { "enabled": true },
                        "pyflakes": { "enabled": false },
                        "pylint": { "enabled": false },
                        "pycodestyle": { "enabled": false },
                        "mccabe": { "enabled": false },
                        "pydocstyle": { "enabled": false },
                        "flake8": { "enabled": false },
                    },
                },
            },
        },
    },
    "languages": {
        "R": {
            "language_servers": ["r_language_server"],
            "format_on_save": "on",
        },
        "Python": {
            "format_on_save": "on",
            "formatter": "language_server",
            "language_servers": ["pylsp"],
        },
        "TOML": {
            "formatter": "language_server",
        },
    },
    "tab_size": 4,
}
