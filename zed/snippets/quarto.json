{
  "Quarto document header": {
    "prefix": "qmd_header",
    "body": [
      "---",
      "format:",
      "  pdf:",
      "    colorlinks: true",
      "    geometry:",
      "      - margin=0.5in",
      "    fontsize: 11pt",
      "    block-headings: false",
      "    linestretch: 1.05",
      "    include-in-header:",
      "      text: |",
      "        \\RedeclareSectionCommand[beforeskip=-0.3em,afterskip=0.2em]{section}",
      "        \\RedeclareSectionCommand[beforeskip=-0.3em,afterskip=0.2em]{subsection}",
      "        \\RedeclareSectionCommand[beforeskip=-0.3em,afterskip=0.2em]{subsubsection}",
      "        \\setlength{\\parskip}{0.3em}",
      "        \\setlength{\\parindent}{0pt}",
      "execute:",
      "  echo: false",
      "  warning: false",
      "  message: false",
      "---",
      "",
      "$0"
    ],
    "description": "Standard Quarto document YAML header"
  }
}
