#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

# Define colors directly (muted blue scheme)
WHITE=0xffffffff
BAR_COLOR=0x000f1419         #0f1419
ITEM_BG_COLOR=0xff1a202c     #1a202c
ACCENT_COLOR=0xff517c9b      #517c9b
MUTED_BLUE_BG=0x661a202c     #1a202c
MUTED_BLUE_BORDER=0xaa517c9b #517c9b

##### Bar Appearance #####
sketchybar --bar position=top height=20 blur_radius=0 color=$BAR_COLOR

##### Changing Defaults #####
default=(
    padding_left=5
    padding_right=5
    icon.font="FiraCode Nerd Font:Bold:12.0"
    label.font="FiraCode Nerd Font:Bold:12.0"
    icon.color=$WHITE
    label.color=$WHITE
    background.color=$MUTED_BLUE_BG
    background.corner_radius=5
    background.height=20
    icon.padding_left=4
    icon.padding_right=4
    label.padding_left=4
    label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Paneru integration #####
# Paneru exposes state via `paneru query` and an event stream via `paneru subscribe`.
# A background listener (paneru_listener.sh) forwards every event as a single
# `paneru_event` trigger; subscribed items re-query paneru when fired.
sketchybar --add event paneru_event

# Active macOS space indicator (e.g. "Space 1").
sketchybar --add item space_indicator left \
    --set space_indicator \
    background.color=$MUTED_BLUE_BG \
    background.corner_radius=6 \
    background.drawing=on \
    background.border_color=$MUTED_BLUE_BORDER \
    background.border_width=0 \
    background.height=20 \
    icon.drawing=off \
    label="Space 1" \
    label.color=0xffffffff \
    label.padding_left=8 \
    label.padding_right=8 \
    script="$PLUGIN_DIR/paneru_strip.sh" \
    --subscribe space_indicator paneru_event

# Icon strip for windows on the active paneru strip.
sketchybar --add item space_strip left \
    --set space_strip \
    background.color=$MUTED_BLUE_BG \
    background.corner_radius=6 \
    background.drawing=on \
    background.height=20 \
    icon.drawing=off \
    label.font="sketchybar-app-font:Regular:16.0" \
    label.color=0xffffffff \
    label.padding_left=6 \
    label.padding_right=10 \
    label.y_offset=-1 \
    label=" " \
    --subscribe space_strip paneru_event

sketchybar --add item space_separator left \
    --set space_separator icon="❙" \
    icon.padding_left=4 \
    label.drawing=off \
    background.drawing=off

# Start the long-running paneru -> sketchybar event bridge.
pkill -f "$PLUGIN_DIR/paneru_listener.sh" 2>/dev/null
nohup "$PLUGIN_DIR/paneru_listener.sh" >/dev/null 2>&1 &
disown 2>/dev/null || true

sketchybar --add item front_app left \
    --set front_app icon.drawing=on \
    icon.font="sketchybar-app-font:Regular:16.0" \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.drawing=on \
    label.padding_left=4 \
    label.padding_right=8 \
    script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

##### Adding Right Items #####
# Note: Right items appear in REVERSE order (first added = rightmost)

# System indicators (rightmost)
sketchybar \
    --add item clock right \
    --set clock update_freq=10 script="$PLUGIN_DIR/clock.sh" \
    --add item vpn right \
    --set vpn update_freq=5 script="$PLUGIN_DIR/vpn.sh" \
    drawing=off \
    --add item wifi right \
    --set wifi update_freq=5 script="$PLUGIN_DIR/wifi.sh" \
    --subscribe wifi wifi_change \
    --add item mic right \
    --set mic update_freq=1 script="$PLUGIN_DIR/mic.sh" \
    click_script="$PLUGIN_DIR/mic_toggle.sh" \
    --subscribe mic mic_change \
    --add item volume right \
    --set volume script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change \
    --add item battery right \
    --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# Separator between system indicators and background apps
sketchybar --add item right_separator right \
    --set right_separator \
    icon="❙" \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.drawing=off \
    background.drawing=off

# Background apps updater (invisible item that triggers the script)
sketchybar --add item background_apps_updater right \
    --set background_apps_updater \
    script="$PLUGIN_DIR/background_apps_dynamic.sh" \
    icon.drawing=off \
    label.drawing=off \
    background.drawing=off \
    width=0 \
    --subscribe background_apps_updater \
    paneru_event \
    front_app_switched

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
